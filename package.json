{
  "name": "mijn-ghast",
  "version": "1.1.0",
  "description": "Een persoonlijke Windows-shortcut-app",
  "author": "tureluur-ux",
  "main": "main.js",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tureluur-ux/mijn-ghast.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "nl.tureluur.mijnghast",
    "productName": "Mijn Ghast",
    "icon": "icon.png",
    "win": {
      "target": "portable",
      "artifactName": "Mijn-Ghast-${version}-Windows.exe",
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "app.js",
      "icon.svg",
      "icon.png"
    ]
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "sharp": "^0.35.5"
  }
}
